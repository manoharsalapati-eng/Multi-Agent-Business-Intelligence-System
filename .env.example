# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values:
#     Windows:   copy .env.example .env
#     Mac/Linux: cp .env.example .env
#
# Never commit your real .env file — it is ignored by .gitignore.
# ---------------------------------------------------------------------------

# REQUIRED — get a free key from https://console.groq.com
GROQ_API_KEY=

# Groq model ID. Leave as-is unless you know you want a different one.
# Note: llama3-70b-8192 and llama-3.3-70b-versatile were both decommissioned
# by Groq, so they will fail. openai/gpt-oss-120b is Groq's replacement.
GROQ_MODEL=openai/gpt-oss-120b

# Backend configuration
API_URL=http://localhost:8000
PORT=8000

# Data locations
DB_PATH=db.sqlite
CHROMA_PATH=chroma_db
